// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    // Compute incremented current value
    Inc16(in=regOut, out=incOut);

    // Priority chain (lowest to highest): inc -> load -> reset
    Mux16(a=regOut, b=incOut, sel=inc, out=muxInc);
    Mux16(a=muxInc, b=in, sel=load, out=muxLoad);
    Mux16(a=muxLoad, b=false, sel=reset, out=muxReset);

    // Store next state (load=true since Mux16s handle holding regOut)
    Register(in=muxReset, load=true, out=regOut, out=out);
}